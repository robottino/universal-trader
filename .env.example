# Universal Trader — Environment Template
# Copy to .env and populate secrets as needed. Never commit .env to git.

# Compute device override: auto | cuda | mps | cpu
UTRADER_DEVICE=auto

# Optional relative/custom runtime directories (defaults are relative to project root)
# UTRADER_DATA_DIR=data_cache
# UTRADER_FORECAST_CACHE_DIR=forecast_cache
# UTRADER_STATE_DIR=state
# UTRADER_REPORTS_DIR=reports
# HF_HOME=.hf_cache

# Bitfinex REST v2 credentials
BITFINEX_PAPER_API_KEY=
BITFINEX_PAPER_API_SECRET=
BITFINEX_LIVE_API_KEY=
BITFINEX_LIVE_API_SECRET=

# Alpaca Markets credentials (Paper & Live)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Interactive Brokers (optional)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Telegram Bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
